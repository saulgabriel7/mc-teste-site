---
interface Props {
    variant?: "hero" | "page";
}

const { variant = "hero" } = Astro.props;
const isHero = variant === "hero";

import { Image } from "astro:assets";
import logo from "../assets/logo.png";
---

<header
    class={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${isHero ? "bg-transparent" : "glass shadow-sm"}`}
    id="header"
>
    <nav class="container-custom py-4">
        <div class="flex items-center justify-between">
            <!-- Logo -->
            <a
                href="/"
                class="flex items-center gap-3 group"
                aria-label="MC Assessoria Imobiliária - Página Inicial"
            >
                <Image
                    src={logo}
                    alt="MC Assessoria Imobiliária"
                    class="h-12 w-auto transition-transform duration-300 group-hover:scale-105"
                />
                <span
                    class="hidden sm:block font-display font-bold text-xl text-white group-hover:text-primary-300 transition-colors duration-300"
                    class:list={[
                        { "text-accent-900 dark:text-white": !isHero },
                    ]}
                >
                    MC Assessoria
                </span>
            </a>

            <!-- Desktop Navigation -->
            <div class="hidden lg:flex items-center gap-8">
                <a href="/" class="nav-link">Início</a>
                <a href="/imoveis" class="nav-link">Imóveis</a>
                <a href="/sobre" class="nav-link">Sobre</a>
                <a href="/indique-seu-imovel" class="nav-link"
                    >Indique seu Imóvel</a
                >
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4">
                <!-- Search Button -->
                <button
                    id="search-btn"
                    class="p-2 rounded-full hover:bg-accent-100 dark:hover:bg-accent-800 transition-colors"
                    aria-label="Buscar imóvel"
                >
                    <i
                        class="ph-bold ph-magnifying-glass text-xl text-white"
                        class:list={[
                            {
                                "!text-accent-800 dark:!text-accent-200":
                                    !isHero,
                            },
                        ]}></i>
                </button>

                <!-- WhatsApp -->
                <a
                    href="https://wa.me/5511947708668?text=Oi,%20vim%20pelo%20site,%20poderia%20me%20ajudar?"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hidden sm:flex items-center gap-2 px-4 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-full font-medium transition-all duration-300 hover:shadow-lg"
                    aria-label="Falar pelo WhatsApp"
                >
                    <i
                        class="ph-bold ph-whatsapp-logo text-lg"
                        aria-hidden="true"></i>
                </a>

                <!-- Mobile Menu Button -->
                <button
                    id="menu-toggle"
                    class="lg:hidden p-2 rounded-full hover:bg-accent-100 dark:hover:bg-accent-800 transition-colors"
                    aria-label="Abrir menu"
                    aria-expanded="false"
                >
                    <i
                        class="ph-bold ph-list text-2xl text-white"
                        class:list={[
                            {
                                "!text-accent-800 dark:!text-accent-200":
                                    !isHero,
                            },
                        ]}></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div
        id="mobile-menu"
        class="fixed inset-0 w-full h-screen z-[100] transform translate-x-full transition-transform duration-300 lg:hidden bg-[#0f172a] overflow-y-auto"
        aria-hidden="true"
    >
        <!-- Content -->
        <div class="flex flex-col min-h-full p-6">
            <div class="flex items-center justify-between mb-8">
                <span class="font-display font-bold text-2xl text-white"
                    >Menu</span
                >
                <button
                    id="menu-close"
                    class="p-2 rounded-full hover:bg-white/10 transition-colors"
                    aria-label="Fechar menu"
                >
                    <i class="ph-bold ph-x text-2xl text-white"></i>
                </button>
            </div>

            <nav class="flex flex-col gap-2">
                <a href="/" class="mobile-nav-link">
                    <i class="ph ph-house"></i> Início
                </a>
                <a href="/imoveis" class="mobile-nav-link">
                    <i class="ph ph-buildings"></i> Imóveis
                </a>
                <a href="/sobre" class="mobile-nav-link">
                    <i class="ph ph-info"></i> Sobre Nós
                </a>
                <a href="/indique-seu-imovel" class="mobile-nav-link">
                    <i class="ph ph-plus-circle"></i> Indique seu Imóvel
                </a>
                <a href="/politica-privacidade" class="mobile-nav-link">
                    <i class="ph ph-shield-check"></i> Privacidade
                </a>
            </nav>

            <div class="mt-auto pt-8 border-t border-white/20">
                <a
                    href="https://wa.me/5511947708668?text=Oi,%20vim%20pelo%20site,%20poderia%20me%20ajudar?"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-3 w-full py-4 bg-primary-500 hover:bg-primary-600 text-white rounded-xl font-semibold transition-all duration-300"
                >
                    <i class="ph-bold ph-whatsapp-logo text-xl"></i>
                    Fale Conosco: (11) 94770-8668
                </a>
            </div>
        </div>
    </div>

    <!-- Search Modal -->
    <div
        id="search-modal"
        class="fixed inset-0 bg-accent-900/80 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300"
        aria-hidden="true"
    >
        <div class="flex items-start justify-center pt-32 px-4">
            <div
                class="w-full max-w-xl bg-white dark:bg-accent-800 rounded-2xl shadow-2xl p-6 transform scale-95 transition-transform duration-300"
                id="search-container"
            >
                <div class="flex items-center gap-4 mb-4">
                    <i
                        class="ph-bold ph-magnifying-glass text-2xl text-accent-400"
                    ></i>
                    <input
                        type="text"
                        id="search-input"
                        placeholder="Buscar por código (ex: IMV001)"
                        class="flex-1 text-lg bg-transparent border-none outline-none text-accent-900 dark:text-white placeholder-accent-400"
                        autocomplete="off"
                    />
                    <button
                        id="search-close"
                        class="p-2 hover:bg-accent-100 dark:hover:bg-accent-700 rounded-lg transition-colors"
                        aria-label="Fechar busca"
                    >
                        <i
                            class="ph-bold ph-x text-xl text-accent-500"
                            aria-hidden="true"></i>
                    </button>
                </div>
                <p class="text-sm text-accent-500 dark:text-accent-400">
                    Digite o código do imóvel e pressione Enter
                </p>
            </div>
        </div>
    </div>
</header>

<style>
    .nav-link {
        @apply relative font-medium text-white/90 hover:text-white transition-colors duration-300;
    }

    .nav-link::after {
        content: "";
        @apply absolute bottom-0 left-0 w-0 h-0.5 bg-primary-400 transition-all duration-300;
    }

    .nav-link:hover::after {
        @apply w-full;
    }

    .mobile-nav-link {
        @apply flex items-center gap-4 px-4 py-4 text-lg text-white/90 hover:text-white hover:bg-white/10 rounded-xl transition-all duration-300;
    }
</style>

<script>
    // Mobile menu
    const menuToggle = document.getElementById("menu-toggle");
    const menuClose = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu");

    menuToggle?.addEventListener("click", () => {
        mobileMenu?.classList.remove("translate-x-full");
        mobileMenu?.setAttribute("aria-hidden", "false");
        menuToggle?.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
    });

    menuClose?.addEventListener("click", () => {
        mobileMenu?.classList.add("translate-x-full");
        mobileMenu?.setAttribute("aria-hidden", "true");
        menuToggle?.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
    });

    // Search modal
    const searchBtn = document.getElementById("search-btn");
    const searchModal = document.getElementById("search-modal");
    const searchClose = document.getElementById("search-close");
    const searchInput = document.getElementById(
        "search-input",
    ) as HTMLInputElement;
    const searchContainer = document.getElementById("search-container");

    searchBtn?.addEventListener("click", () => {
        searchModal?.classList.remove("opacity-0", "pointer-events-none");
        searchContainer?.classList.remove("scale-95");
        searchInput?.focus();
    });

    const closeSearch = () => {
        searchModal?.classList.add("opacity-0", "pointer-events-none");
        searchContainer?.classList.add("scale-95");
    };

    searchClose?.addEventListener("click", closeSearch);
    searchModal?.addEventListener("click", (e) => {
        if (e.target === searchModal) closeSearch();
    });

    searchInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
            const code = searchInput.value.trim().toUpperCase();
            if (/^IMV\d{3}$/i.test(code)) {
                window.location.href = `/imoveis/imovel/${code}`;
            } else {
                searchInput.classList.add("animate-shake");
                setTimeout(
                    () => searchInput.classList.remove("animate-shake"),
                    500,
                );
            }
        }
        if (e.key === "Escape") closeSearch();
    });

    // Header scroll effect
    const header = document.getElementById("header");
    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            header?.classList.add("glass", "shadow-sm");
            header?.classList.remove("bg-transparent");
        } else if (header?.dataset.variant === "hero") {
            header?.classList.remove("glass", "shadow-sm");
            header?.classList.add("bg-transparent");
        }
    });
</script>
