---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
    title="Indique seu Imóvel - MC Assessoria Imobiliária"
    description="Cadastre seu imóvel comercial gratuitamente e alcance empresas em busca do espaço ideal."
>
    <Header variant="page" />

    <main class="pt-24 pb-16 min-h-screen bg-accent-50 dark:bg-accent-900">
        <div class="container-custom max-w-4xl">
            <!-- Header -->
            <div class="text-center mb-12">
                <span
                    class="inline-block px-4 py-2 bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 rounded-full text-sm font-medium mb-4"
                >
                    <i class="ph ph-plus-circle mr-2"></i>
                    Cadastro de Imóveis
                </span>
                <h1 class="section-title">Indique seu Imóvel</h1>
                <p class="section-subtitle max-w-xl mx-auto">
                    Preencha o formulário abaixo para cadastrar seu imóvel.
                    Nossa equipe entrará em contato em até 24 horas.
                </p>
            </div>

            <!-- Progress Steps -->
            <div class="mb-10">
                <div class="flex items-center justify-between relative">
                    <div
                        class="absolute top-5 left-0 right-0 h-0.5 bg-accent-200 dark:bg-accent-700"
                    >
                    </div>
                    <div
                        class="absolute top-5 left-0 h-0.5 bg-primary-500 transition-all duration-500"
                        id="progress-bar"
                        style="width: 0%"
                    >
                    </div>

                    {
                        [
                            {
                                num: 1,
                                label: "Dados Pessoais",
                                icon: "ph-user",
                            },
                            {
                                num: 2,
                                label: "Informações do Imóvel",
                                icon: "ph-buildings",
                            },
                            {
                                num: 3,
                                label: "Valores",
                                icon: "ph-currency-circle-dollar",
                            },
                            {
                                num: 4,
                                label: "Confirmação",
                                icon: "ph-check-circle",
                            },
                        ].map((step) => (
                            <div
                                class="step-indicator relative z-10 flex flex-col items-center"
                                data-step={step.num}
                            >
                                <div
                                    class={`w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold transition-all duration-300 ${step.num === 1 ? "bg-primary-500 text-white" : "bg-accent-200 dark:bg-accent-700 text-accent-500 dark:text-accent-400"}`}
                                >
                                    <i class={`ph ${step.icon}`} />
                                </div>
                                <span class="text-xs text-accent-500 dark:text-accent-400 mt-2 hidden sm:block">
                                    {step.label}
                                </span>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Form Card -->
            <div class="card p-6 md:p-10">
                <form id="property-form" class="space-y-6">
                    <!-- Step 1: Personal Data -->
                    <div class="form-step" data-step="1">
                        <h2
                            class="text-xl font-display font-semibold text-accent-900 dark:text-white mb-6 flex items-center gap-3"
                        >
                            <i class="ph ph-user text-primary-500"></i>
                            Dados Pessoais
                        </h2>

                        <div class="space-y-4">
                            <div>
                                <label
                                    for="nome"
                                    class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                    >Nome Completo *</label
                                >
                                <input
                                    type="text"
                                    id="nome"
                                    name="nome"
                                    class="input"
                                    placeholder="Seu nome completo"
                                    required
                                />
                            </div>

                            <div class="grid md:grid-cols-2 gap-4">
                                <div>
                                    <label
                                        for="email"
                                        class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                        >E-mail *</label
                                    >
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        class="input"
                                        placeholder="seu@email.com"
                                        required
                                    />
                                </div>
                                <div>
                                    <label
                                        for="telefone"
                                        class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                        >Telefone com DDD *</label
                                    >
                                    <input
                                        type="tel"
                                        id="telefone"
                                        name="telefone"
                                        class="input"
                                        placeholder="(11) 99999-9999"
                                        required
                                    />
                                </div>
                            </div>

                            <div>
                                <label
                                    for="perfil"
                                    class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                    >Tipo de Perfil *</label
                                >
                                <select
                                    id="perfil"
                                    name="perfil"
                                    class="select"
                                    required
                                >
                                    <option value=""
                                        >Selecione seu perfil</option
                                    >
                                    <option value="Proprietário"
                                        >Proprietário</option
                                    >
                                    <option value="Franqueado"
                                        >Franqueado</option
                                    >
                                    <option value="Investidor"
                                        >Investidor</option
                                    >
                                    <option value="Corretor">Corretor</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Property Info -->
                    <div class="form-step hidden" data-step="2">
                        <h2
                            class="text-xl font-display font-semibold text-accent-900 dark:text-white mb-6 flex items-center gap-3"
                        >
                            <i class="ph ph-buildings text-primary-500"></i>
                            Informações do Imóvel
                        </h2>

                        <div class="space-y-4">
                            <div class="grid md:grid-cols-2 gap-4">
                                <div>
                                    <label
                                        for="endereco"
                                        class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                        >Endereço *</label
                                    >
                                    <input
                                        type="text"
                                        id="endereco"
                                        name="endereco"
                                        class="input"
                                        placeholder="Rua, número, bairro"
                                        required
                                    />
                                </div>
                                <div>
                                    <label
                                        for="cep"
                                        class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                        >CEP</label
                                    >
                                    <input
                                        type="text"
                                        id="cep"
                                        name="cep"
                                        class="input"
                                        placeholder="00000-000"
                                        maxlength="9"
                                    />
                                </div>
                            </div>

                            <div class="grid md:grid-cols-2 gap-4">
                                <div>
                                    <label
                                        for="tipo"
                                        class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                        >Tipo de Imóvel *</label
                                    >
                                    <select
                                        id="tipo"
                                        name="tipo"
                                        class="select"
                                        required
                                    >
                                        <option value=""
                                            >Selecione o tipo</option
                                        >
                                        <option value="Galpão">Galpão</option>
                                        <option value="Loja">Loja</option>
                                        <option value="Salão Comercial"
                                            >Salão Comercial</option
                                        >
                                        <option value="Prédio Comercial"
                                            >Prédio Comercial</option
                                        >
                                        <option value="BTS"
                                            >BTS (Build to Suit)</option
                                        >
                                        <option value="Outro">Outro</option>
                                    </select>
                                </div>
                                <div>
                                    <label
                                        for="metragem"
                                        class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                        >Metragem (m²) *</label
                                    >
                                    <input
                                        type="text"
                                        id="metragem"
                                        name="metragem"
                                        class="input"
                                        placeholder="Ex: 1500"
                                        required
                                    />
                                </div>
                            </div>

                            <div>
                                <label
                                    for="vagas"
                                    class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                    >Vagas de Estacionamento</label
                                >
                                <input
                                    type="text"
                                    id="vagas"
                                    name="vagas"
                                    class="input"
                                    placeholder="Número de vagas"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Values -->
                    <div class="form-step hidden" data-step="3">
                        <h2
                            class="text-xl font-display font-semibold text-accent-900 dark:text-white mb-6 flex items-center gap-3"
                        >
                            <i
                                class="ph ph-currency-circle-dollar text-primary-500"
                            ></i>
                            Valores e Informações Adicionais
                        </h2>

                        <div class="space-y-4">
                            <div class="grid md:grid-cols-2 gap-4">
                                <div>
                                    <label
                                        for="aluguel"
                                        class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                        >Valor do Aluguel (R$)</label
                                    >
                                    <input
                                        type="text"
                                        id="aluguel"
                                        name="aluguel"
                                        class="input"
                                        placeholder="Ex: 50.000"
                                    />
                                </div>
                                <div>
                                    <label
                                        for="iptu"
                                        class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                        >IPTU Anual (R$)</label
                                    >
                                    <input
                                        type="text"
                                        id="iptu"
                                        name="iptu"
                                        class="input"
                                        placeholder="Ex: 12.000"
                                    />
                                </div>
                            </div>

                            <div>
                                <label
                                    for="link"
                                    class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                    >Link de Anúncio (opcional)</label
                                >
                                <input
                                    type="url"
                                    id="link"
                                    name="link"
                                    class="input"
                                    placeholder="https://..."
                                />
                            </div>

                            <div>
                                <label
                                    for="link_arquivo"
                                    class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                    >Link para Fotos/Documentos</label
                                >
                                <input
                                    type="url"
                                    id="link_arquivo"
                                    name="link_arquivo"
                                    class="input"
                                    placeholder="Google Drive, WeTransfer, etc."
                                />
                            </div>

                            <div>
                                <label
                                    for="comentario"
                                    class="block text-sm font-medium text-accent-700 dark:text-accent-300 mb-2"
                                    >Comentários Adicionais</label
                                >
                                <textarea
                                    id="comentario"
                                    name="comentario"
                                    rows="4"
                                    class="input resize-none"
                                    placeholder="Informações extras sobre o imóvel..."
                                ></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4: Confirmation -->
                    <div class="form-step hidden" data-step="4">
                        <h2
                            class="text-xl font-display font-semibold text-accent-900 dark:text-white mb-6 flex items-center gap-3"
                        >
                            <i class="ph ph-check-circle text-primary-500"></i>
                            Confirme seus Dados
                        </h2>

                        <div
                            class="bg-accent-50 dark:bg-accent-800 rounded-xl p-6 mb-6"
                        >
                            <div id="summary" class="space-y-4 text-sm">
                                <!-- Summary will be populated by JS -->
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <input
                                type="checkbox"
                                id="termos"
                                name="termos"
                                class="mt-1 w-5 h-5 rounded border-accent-300 text-primary-500 focus:ring-primary-500"
                                required
                            />
                            <label
                                for="termos"
                                class="text-accent-600 dark:text-accent-400 text-sm"
                            >
                                Li e aceito os <a
                                    href="/politica-privacidade"
                                    target="_blank"
                                    class="text-primary-500 hover:underline"
                                    >termos de política e privacidade</a
                                >.
                            </label>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div
                        class="flex items-center justify-between pt-6 border-t border-accent-200 dark:border-accent-700"
                    >
                        <button
                            type="button"
                            id="prev-btn"
                            class="btn-secondary hidden"
                        >
                            <i class="ph ph-arrow-left"></i>
                            Voltar
                        </button>
                        <div class="flex-1"></div>
                        <button type="button" id="next-btn" class="btn-primary">
                            Próximo
                            <i class="ph ph-arrow-right"></i>
                        </button>
                        <button
                            type="submit"
                            id="submit-btn"
                            class="btn-primary hidden"
                        >
                            <i class="ph ph-paper-plane-tilt"></i>
                            Enviar Cadastro
                        </button>
                    </div>
                </form>
            </div>

            <!-- Benefits -->
            <div class="mt-12 grid md:grid-cols-3 gap-6">
                <div class="flex items-start gap-4">
                    <div
                        class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center flex-shrink-0"
                    >
                        <i
                            class="ph ph-shield-check text-2xl text-primary-600 dark:text-primary-400"
                        ></i>
                    </div>
                    <div>
                        <h3
                            class="font-semibold text-accent-900 dark:text-white mb-1"
                        >
                            100% Seguro
                        </h3>
                        <p class="text-sm text-accent-600 dark:text-accent-400">
                            Seus dados estão protegidos e não serão
                            compartilhados.
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div
                        class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center flex-shrink-0"
                    >
                        <i
                            class="ph ph-clock text-2xl text-primary-600 dark:text-primary-400"
                        ></i>
                    </div>
                    <div>
                        <h3
                            class="font-semibold text-accent-900 dark:text-white mb-1"
                        >
                            Resposta Rápida
                        </h3>
                        <p class="text-sm text-accent-600 dark:text-accent-400">
                            Retornamos em até 24 horas úteis.
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div
                        class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center flex-shrink-0"
                    >
                        <i
                            class="ph ph-currency-circle-dollar text-2xl text-primary-600 dark:text-primary-400"
                        ></i>
                    </div>
                    <div>
                        <h3
                            class="font-semibold text-accent-900 dark:text-white mb-1"
                        >
                            Gratuito
                        </h3>
                        <p class="text-sm text-accent-600 dark:text-accent-400">
                            Cadastro e divulgação sem custo.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Success Modal -->
    <div
        id="success-modal"
        class="fixed inset-0 bg-accent-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
    >
        <div
            class="bg-white dark:bg-accent-800 rounded-2xl p-8 max-w-md w-full text-center transform scale-95 transition-transform duration-300"
        >
            <div
                class="w-20 h-20 mx-auto mb-6 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center"
            >
                <i
                    class="ph-bold ph-check text-4xl text-green-600 dark:text-green-400"
                ></i>
            </div>
            <h3
                class="text-2xl font-display font-bold text-accent-900 dark:text-white mb-3"
            >
                Cadastro Enviado!
            </h3>
            <p class="text-accent-600 dark:text-accent-400 mb-6">
                Recebemos suas informações. Nossa equipe entrará em contato em
                breve.
            </p>
            <a href="/" class="btn-primary w-full"> Voltar ao Início </a>
        </div>
    </div>

    <Footer />
</BaseLayout>

<script>
    let currentStep = 1;
    const totalSteps = 4;

    const form = document.getElementById("property-form") as HTMLFormElement;
    const steps = document.querySelectorAll(".form-step");
    const indicators = document.querySelectorAll(".step-indicator");
    const progressBar = document.getElementById("progress-bar");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const submitBtn = document.getElementById("submit-btn");
    const successModal = document.getElementById("success-modal");

    function updateUI() {
        // Update steps visibility
        steps.forEach((step) => {
            const stepNum = parseInt((step as HTMLElement).dataset.step || "0");
            step.classList.toggle("hidden", stepNum !== currentStep);
        });

        // Update indicators
        indicators.forEach((indicator) => {
            const stepNum = parseInt(
                (indicator as HTMLElement).dataset.step || "0",
            );
            const circle = indicator.querySelector("div");
            if (stepNum <= currentStep) {
                circle?.classList.add("bg-primary-500", "text-white");
                circle?.classList.remove(
                    "bg-accent-200",
                    "dark:bg-accent-700",
                    "text-accent-500",
                    "dark:text-accent-400",
                );
            } else {
                circle?.classList.remove("bg-primary-500", "text-white");
                circle?.classList.add(
                    "bg-accent-200",
                    "dark:bg-accent-700",
                    "text-accent-500",
                    "dark:text-accent-400",
                );
            }
        });

        // Update progress bar
        const progress = ((currentStep - 1) / (totalSteps - 1)) * 100;
        if (progressBar) progressBar.style.width = `${progress}%`;

        // Update buttons
        prevBtn?.classList.toggle("hidden", currentStep === 1);
        nextBtn?.classList.toggle("hidden", currentStep === totalSteps);
        submitBtn?.classList.toggle("hidden", currentStep !== totalSteps);

        // Update summary on last step
        if (currentStep === totalSteps) {
            updateSummary();
        }
    }

    function validateCurrentStep(): boolean {
        const currentStepEl = document.querySelector(
            `.form-step[data-step="${currentStep}"]`,
        );
        const inputs = currentStepEl?.querySelectorAll(
            "input[required], select[required]",
        );
        let valid = true;

        inputs?.forEach((input) => {
            const el = input as HTMLInputElement | HTMLSelectElement;
            if (!el.value.trim()) {
                el.classList.add("ring-2", "ring-red-500");
                valid = false;
            } else {
                el.classList.remove("ring-2", "ring-red-500");
            }
        });

        if (!valid) {
            const firstInvalid = currentStepEl?.querySelector(
                ".ring-red-500",
            ) as HTMLElement;
            firstInvalid?.focus();
        }

        return valid;
    }

    function updateSummary() {
        const summary = document.getElementById("summary");
        if (!summary) return;

        const fields = [
            { label: "Nome", id: "nome" },
            { label: "E-mail", id: "email" },
            { label: "Telefone", id: "telefone" },
            { label: "Perfil", id: "perfil" },
            { label: "Endereço", id: "endereco" },
            { label: "CEP", id: "cep" },
            { label: "Tipo", id: "tipo" },
            { label: "Metragem", id: "metragem" },
            { label: "Aluguel", id: "aluguel" },
            { label: "IPTU", id: "iptu" },
        ];

        summary.innerHTML = fields
            .filter(
                (f) =>
                    (
                        document.getElementById(f.id) as
                            | HTMLInputElement
                            | HTMLSelectElement
                    )?.value,
            )
            .map((f) => {
                const value = (
                    document.getElementById(f.id) as
                        | HTMLInputElement
                        | HTMLSelectElement
                )?.value;
                return `<div class="flex justify-between py-2 border-b border-accent-200 dark:border-accent-700 last:border-0">
          <span class="text-accent-500 dark:text-accent-400">${f.label}</span>
          <span class="font-medium text-accent-900 dark:text-white">${value}</span>
        </div>`;
            })
            .join("");
    }

    prevBtn?.addEventListener("click", () => {
        if (currentStep > 1) {
            currentStep--;
            updateUI();
        }
    });

    nextBtn?.addEventListener("click", () => {
        if (validateCurrentStep() && currentStep < totalSteps) {
            currentStep++;
            updateUI();
            window.scrollTo({ top: 0, behavior: "smooth" });
        }
    });

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const termos = document.getElementById("termos") as HTMLInputElement;
        if (!termos?.checked) {
            termos?.focus();
            return;
        }

        // Disable button
        if (submitBtn) {
            submitBtn.setAttribute("disabled", "true");
            submitBtn.innerHTML =
                '<i class="ph ph-spinner animate-spin"></i> Enviando...';
        }

        // Send via FormSubmit (AJAX)
        try {
            const formData = new FormData(form);

            // Adiciona configuração para json response
            // formData.append("_captcha", "false"); // Opcional: desativar captcha
            // formData.append("_subject", "Novo Cadastro de Imóvel");

            const response = await fetch(
                "https://formsubmit.co/ajax/mc.imoveis11@gmail.com",
                {
                    method: "POST",
                    body: formData,
                },
            );

            const result = await response.json();

            if (response.ok) {
                successModal?.classList.remove(
                    "opacity-0",
                    "pointer-events-none",
                );
                successModal
                    ?.querySelector("div")
                    ?.classList.remove("scale-95");
            } else {
                console.error("Erro no envio:", result);
                throw new Error("Failed");
            }
        } catch (error) {
            alert(
                "Erro ao enviar. Por favor, tente novamente ou entre em contato via WhatsApp.",
            );
            if (submitBtn) {
                submitBtn.removeAttribute("disabled");
                submitBtn.innerHTML =
                    '<i class="ph ph-paper-plane-tilt"></i> Enviar Cadastro';
            }
        }
    });

    // CEP formatting
    const cepInput = document.getElementById("cep") as HTMLInputElement;
    cepInput?.addEventListener("input", (e) => {
        let value = (e.target as HTMLInputElement).value.replace(/\D/g, "");
        if (value.length > 5) {
            value = value.slice(0, 5) + "-" + value.slice(5, 8);
        }
        (e.target as HTMLInputElement).value = value;
    });

    // Phone formatting
    const telefoneInput = document.getElementById(
        "telefone",
    ) as HTMLInputElement;
    telefoneInput?.addEventListener("input", (e) => {
        let value = (e.target as HTMLInputElement).value.replace(/\D/g, "");
        if (value.length > 11) value = value.slice(0, 11);
        if (value.length > 7) {
            value = `(${value.slice(0, 2)}) ${value.slice(2, 7)}-${value.slice(7)}`;
        } else if (value.length > 2) {
            value = `(${value.slice(0, 2)}) ${value.slice(2)}`;
        }
        (e.target as HTMLInputElement).value = value;
    });

    updateUI();
</script>
