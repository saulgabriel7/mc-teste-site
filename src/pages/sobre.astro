---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
    title="Sobre Nós - MC Assessoria Imobiliária"
    description="Conheça a MC Assessoria Imobiliária. Especialistas em imóveis comerciais em São Paulo e região."
>
    <Header variant="page" />

    <main class="pt-24 pb-16 bg-white dark:bg-accent-950">
        <!-- Hero Section -->
        <section class="py-16 bg-gradient-hero">
            <div class="container-custom text-center">
                <h1
                    class="text-4xl md:text-5xl font-display font-bold text-white mb-6"
                >
                    Sobre a MC Assessoria
                </h1>
                <p class="text-lg text-accent-300 max-w-2xl mx-auto">
                    Somos especialistas em conectar empresas aos melhores
                    espaços comerciais do mercado.
                </p>
            </div>
        </section>

        <!-- Content -->
        <section class="py-16">
            <div class="container-custom">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div>
                        <span
                            class="inline-block px-4 py-2 bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 rounded-full text-sm font-medium mb-6"
                        >
                            Nossa História
                        </span>
                        <h2
                            class="text-3xl font-display font-bold text-accent-900 dark:text-white mb-6"
                        >
                            Excelência em Imóveis Comerciais
                        </h2>
                        <div
                            class="space-y-4 text-accent-600 dark:text-accent-400"
                        >
                            <p>
                                A MC Assessoria Imobiliária nasceu da paixão por
                                conectar empreendedores e empresas aos espaços
                                perfeitos para suas operações. Com anos de
                                experiência no mercado imobiliário, nos
                                especializamos em imóveis comerciais, oferecendo
                                um portfólio diversificado de galpões, lojas e
                                espaços industriais.
                            </p>
                            <p>
                                Nossa missão é simplificar o processo de locação
                                e venda de imóveis comerciais, garantindo que
                                cada cliente encontre o espaço ideal para fazer
                                seu negócio prosperar. Trabalhamos com
                                transparência, agilidade e compromisso com a
                                satisfação total.
                            </p>
                            <p>
                                Com atuação em São Paulo e diversas regiões do
                                Brasil, somos referência quando o assunto é
                                encontrar o imóvel comercial perfeito para sua
                                empresa.
                            </p>
                        </div>
                    </div>

                    <div class="relative">
                        <div
                            class="card p-8 bg-gradient-to-br from-primary-500 to-primary-700 text-white"
                        >
                            <div class="grid grid-cols-2 gap-8">
                                <div class="text-center">
                                    <p class="text-4xl font-bold mb-2">26+</p>
                                    <p class="text-primary-100">
                                        Imóveis Ativos
                                    </p>
                                </div>
                                <div class="text-center">
                                    <p class="text-4xl font-bold mb-2">15+</p>
                                    <p class="text-primary-100">Cidades</p>
                                </div>
                                <div class="text-center">
                                    <p class="text-4xl font-bold mb-2">100%</p>
                                    <p class="text-primary-100">Satisfação</p>
                                </div>
                                <div class="text-center">
                                    <p class="text-4xl font-bold mb-2">24h</p>
                                    <p class="text-primary-100">Atendimento</p>
                                </div>
                            </div>
                        </div>
                        <!-- Decorative elements -->
                        <div
                            class="absolute -top-4 -right-4 w-24 h-24 bg-primary-200 dark:bg-primary-900/30 rounded-full -z-10"
                        >
                        </div>
                        <div
                            class="absolute -bottom-4 -left-4 w-16 h-16 bg-primary-300 dark:bg-primary-800/30 rounded-full -z-10"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Values -->
        <section class="py-16 bg-accent-50 dark:bg-accent-900">
            <div class="container-custom">
                <div class="text-center mb-12">
                    <h2 class="section-title">Nossos Valores</h2>
                    <p class="section-subtitle">O que nos move todos os dias</p>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    <div class="card p-8 text-center">
                        <div
                            class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center"
                        >
                            <i
                                class="ph-bold ph-handshake text-3xl text-primary-600 dark:text-primary-400"
                            ></i>
                        </div>
                        <h3
                            class="font-display font-semibold text-xl text-accent-900 dark:text-white mb-3"
                        >
                            Transparência
                        </h3>
                        <p class="text-accent-600 dark:text-accent-400">
                            Atuamos com honestidade e clareza em todas as
                            negociações.
                        </p>
                    </div>

                    <div class="card p-8 text-center">
                        <div
                            class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center"
                        >
                            <i
                                class="ph-bold ph-rocket-launch text-3xl text-primary-600 dark:text-primary-400"
                            ></i>
                        </div>
                        <h3
                            class="font-display font-semibold text-xl text-accent-900 dark:text-white mb-3"
                        >
                            Agilidade
                        </h3>
                        <p class="text-accent-600 dark:text-accent-400">
                            Processos rápidos e eficientes para você iniciar
                            suas operações.
                        </p>
                    </div>

                    <div class="card p-8 text-center">
                        <div
                            class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center"
                        >
                            <i
                                class="ph-bold ph-heart text-3xl text-primary-600 dark:text-primary-400"
                            ></i>
                        </div>
                        <h3
                            class="font-display font-semibold text-xl text-accent-900 dark:text-white mb-3"
                        >
                            Compromisso
                        </h3>
                        <p class="text-accent-600 dark:text-accent-400">
                            Estamos comprometidos com a satisfação total de cada
                            cliente.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-16">
            <div class="container-custom">
                <div class="card p-8 md:p-12 bg-gradient-primary text-center">
                    <h2
                        class="text-2xl md:text-3xl font-display font-bold text-white mb-4"
                    >
                        Pronto para encontrar seu imóvel ideal?
                    </h2>
                    <p class="text-white/80 mb-8 max-w-xl mx-auto">
                        Entre em contato conosco e deixe-nos ajudar você a
                        encontrar o espaço perfeito para seu negócio.
                    </p>
                    <div
                        class="flex flex-col sm:flex-row items-center justify-center gap-4"
                    >
                        <a
                            href="/imoveis"
                            class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary-600 font-semibold rounded-xl hover:bg-accent-50 transition-colors"
                        >
                            <i class="ph-bold ph-buildings"></i>
                            Ver Imóveis
                        </a>
                        <a
                            href="https://wa.me/5511947708668?text=Oi,%20vim%20pelo%20site,%20poderia%20me%20ajudar?"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-white text-white font-semibold rounded-xl hover:bg-white/10 transition-colors"
                        >
                            <i class="ph-bold ph-whatsapp-logo"></i>
                            Falar no WhatsApp
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
